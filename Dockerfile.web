# Web Mon Petit Voyageur — Vite build served by vite preview
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
RUN npm ci --include=dev
COPY . .
# Railway passes service variables as build args: they are baked into the bundle here.
ARG VITE_API_BASE_URL
ARG MAPBOX_ACCESS_TOKEN
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL MAPBOX_ACCESS_TOKEN=$MAPBOX_ACCESS_TOKEN
RUN npm run build -w @mlt/contracts && npm run build -w @mlt/web
ENV NODE_ENV=production
CMD npm run preview -w @mlt/web -- --host 0.0.0.0 --port ${PORT:-4173}
