# Shared
NODE_ENV=development
PORT=8787
JWT_SECRET=change-me-in-production
SQLITE_PATH=apps/api/data/mlt.sqlite

# IA (cerveau des skills) — "auto" utilise DeepSeek si sa clé est renseignée, sinon OpenAI
LLM_PROVIDER=auto

# DeepSeek (clé sur https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Sherpa
SHERPA_API_KEY=
SHERPA_BASE_URL=https://requirements-api.sherpa.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# Mapbox — carte interactive (guide + app). Jeton public "pk." sur https://account.mapbox.com
# Gratuit jusqu'à 50 000 chargements/mois. Sans jeton : Leaflet/OpenStreetMap dans le guide.
MAPBOX_ACCESS_TOKEN=
# Jeton NON restreint pour les appels serveur (image statique de la carte dans le guide).
# Un jeton restreint par URL ne répond qu'aux navigateurs.
MAPBOX_SERVER_TOKEN=

# Photos du guide — optionnelles.
# Le guide est illustré sans aucune clé (Wikipédia, Wikimedia Commons, Openverse).
# Ces clés ajoutent seulement des sources pour les photos génériques (plats, ambiance).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Envoi du guide par mail (SMTP au choix: Gmail, Brevo, Mailgun, OVH...).
# Gmail: activez la validation en 2 étapes puis créez un "mot de passe d'application".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend
VITE_API_BASE_URL=http://localhost:8787

# SerpApi (Google Flights / Google Hotels, remplace Amadeus)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_CAP=200
SERPAPI_FLEX_DATE_SAMPLES=3

# Affiliation Viator (tableau de bord partenaire) — posée sur chaque lien Viator
VIATOR_AFFILIATE_PID=P00277065
VIATOR_AFFILIATE_MCID=42383

# Travelpayouts / Aviasales — calendrier des prix du mois (gratuit, compte affilié) : https://www.travelpayouts.com → Tools → API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Carte : requêtes Nominatim (gratuites, 1/s) au maximum par plan pour placer visites et sites payants ; le cache disque ne compte pas
GEOCODE_MAX_PER_PLAN=20

# --- Abonnement & paiement (Stripe) ---------------------------------------
# Tant que STRIPE_SECRET_KEY est vide, le paiement est "non configuré" :
# l'appli reste ouverte à tous. Dès que les clés sont posées, le paywall
# s'active (essai gratuit puis abonnement obligatoire).
# Clés sur https://dashboard.stripe.com (mode Test d'abord : sk_test_...).
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=
# Secret du endpoint webhook (whsec_...) créé dans Stripe → Developers → Webhooks,
# pointant sur <API>/api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix récurrents créés dans Stripe → Products (price_...).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Durée de l'essai gratuit, en jours (une seule fois par compte).
TRIAL_DAYS=7

# --- Connexion Google (OAuth 2.0) -----------------------------------------
# https://console.cloud.google.com → APIs & Services → Credentials.
# L'URI de redirection autorisée doit être <API>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
